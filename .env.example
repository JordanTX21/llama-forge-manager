# Llama.cpp Binary Path (Relative to the project root)
LLAMA_BIN_DIR=
LLAMA_SERVER_EXE=llama-server.exe

# Default Inference Parameters
DEFAULT_HOST=127.0.0.1
DEFAULT_PORT=5170

DEFAULT_MAX_CONTEXT_TOKENS=128000
DEFAULT_MAX_OUTPUT_TOKENS=64000

# Optional: HuggingFace Token for private models (leave blank if not needed)
